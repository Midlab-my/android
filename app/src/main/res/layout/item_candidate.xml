<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/worky_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="15sp"
            tools:text="Ana Silva" />

        <TextView
            android:id="@+id/textCandidateMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/worky_blue"
            android:textStyle="bold"
            tools:text="86%" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCandidateMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/worky_muted"
        android:textSize="13sp"
        tools:text="Frontend · Remoto · email" />

    <TextView
        android:id="@+id/textCandidateSkills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:textSize="13sp"
        tools:text="React · TypeScript" />

    <TextView
        android:id="@+id/textCandidateLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/company_locked"
        android:textColor="@color/worky_muted"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
