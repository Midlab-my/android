<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/textSuggestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/search_popular"
        android:textAllCaps="true"
        android:textColor="#FF94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipDropdownSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />

    <TextView
        android:id="@+id/textSuggestEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/search_suggest_empty"
        android:textColor="#FF94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutDropdownRecents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/home_recents_label"
            android:textAllCaps="true"
            android:textColor="#FF94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipDropdownRecents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#FFEEF2F7" />

    <LinearLayout
        android:id="@+id/btnToggleFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.07"
            android:text="@string/search_filters"
            android:textAllCaps="true"
            android:textColor="#FF64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFiltersValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iconFiltersChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/search_accordion_hint"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFiltersPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_country"
            android:textAllCaps="true"
            android:textColor="#FF64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickCountry"
            style="@style/Widget.Worky.Button.FilterPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/search_qualquer_pais" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/search_region"
            android:textAllCaps="true"
            android:textColor="#FF64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickRegion"
            style="@style/Widget.Worky.Button.FilterPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/search_qualquer_estado" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/search_modelo"
            android:textAllCaps="true"
            android:textColor="#FF64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickModelo"
            style="@style/Widget.Worky.Button.FilterPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/search_qualquer_modelo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFEEF2F7" />

    <LinearLayout
        android:id="@+id/btnToggleFonte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.07"
            android:text="@string/search_fonte"
            android:textAllCaps="true"
            android:textColor="#FF64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFonteValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iconFonteChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/search_accordion_hint"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFontePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFonteWorky"
            style="@style/Widget.Worky.Button.Outlined.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fonte_worky" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFonteGoogle"
            style="@style/Widget.Worky.Button.Outlined.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fonte_google_jobs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFonteAll"
            style="@style/Widget.Worky.Button.Outlined.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fonte_ambos" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/search_fonte_hint"
            android:textColor="#FF94A3B8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
