<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_wrap"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textJobInitials"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_job_initials"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="AC" />

        <TextView
            android:id="@+id/textJobTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Desenvolvedor Frontend" />
    </LinearLayout>

    <TextView
        android:id="@+id/textJobCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/worky_muted"
        android:textSize="13sp"
        tools:text="Empresa" />

    <LinearLayout
        android:id="@+id/layoutJobTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textJobBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_home_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/worky_blue_bright"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="Worky" />

        <TextView
            android:id="@+id/textJobLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_filter_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#FF334155"
            android:textSize="11sp"
            tools:text="Remoto" />
    </LinearLayout>

    <TextView
        android:id="@+id/textJobMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/worky_muted"
        android:textSize="12sp"
        tools:text="Salário · Contrato" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJobOpen"
        style="@style/Widget.Worky.Button.NavPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:text="@string/result_job_open" />
</LinearLayout>
